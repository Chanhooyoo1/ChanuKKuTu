extends layout

block Subject
	title 차누끄투 - DB 관리

block Middle
	fieldset
		legend 자격
		input#db-password(type='password', placeholder='암호')
		input#db-lang(placeholder='테이블')
	fieldset
		legend 상점 DB 다루기
		div
			input#shop-word(placeholder='품목 (~ALL)')
			button#shop-go 조회
			button#shop-hide 숨기기
			div
				table
					thead: tr
						td #
						td(title='cost') 가격
						td(title='hit') 사용 횟수
						td(title='term') 유효기간
						td(title='group') 분류
						td(title='updatedAt') 수정일
						td(title='options') 옵션
						td(title='name_ko_KR') 이름(한국어)
						td(title='desc_ko_KR') 설명(한국어)
						td(title='name_en_US') 이름(영어)
						td(title='desc_en_US') 설명(영어)
					tbody#shop-data
			button#shop-add 추가
			button#shop-apply 적용
	fieldset
		legend 유저 DB 다루기
		div
			input#user-id(placeholder='ID')
			input#user-nick(placeholder='닉네임')
			button#user-go 조회
			div
				table
					thead: tr
						td #
						td(title='money') 재화
						td(title='kkutu') 끄투 정보
						td(title='box') 보관함
						td(title='equip') 장착된 아이템 정보
						td(title='nickname') 닉네임
						td(title='nickChanged') 닉네임 변경일
						td(title='exordial') 소개말
						td(title='server') 서버
						td(title='lastLogin') 마지막 접속
						td(title='black') 차단 여부
						td(title='blockedUntil') 차단 만료일
						td(title='friends') 친구 목록
					tbody#user-data
			button#user-apply 적용
	fieldset
		legend 유저 감시하기
		div
			input#gamsi-id(placeholder='ID (,로 구분)')
			button#gamsi-go 감시
			div
				table
					thead: tr
						td #
						td 닉네임
						td 서버 (소속)
					tbody#gamsi-data
	fieldset
		legend 끄투 DB 다루기
		div
			input#db-word(placeholder='단어')
			button#db-go 조회
			div#word-data
				div#wd-id
				input#wd-flag
				table
					thead: tr
						td #
						td(title='type') 유형
						td(title='theme') 주제
						td(title='mean') 뜻
						td 행동
					tbody#wd-data
			div#word-flag
			div#word-hit
			button#word-add 추가
			button#db-apply 적용
	fieldset
		legend 끄투 DB에 단어 추가하기
		div
			input#db-theme(placeholder='주제 (~부터 적으면 검색)')
			textarea#db-list(rows=20, cols=100)
			button#db-ok 확인
